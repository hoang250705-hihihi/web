<%- include('../layouts/main-header') %>

<div class="container product-detail">
  <div class="product-detail-wrapper">

    <!-- ẢNH SẢN PHẨM -->
    <div class="product-detail-image">
      <% if (sanpham.hinhanh) { %>
        <img
          src="/uploads/sanpham/<%= sanpham.hinhanh %>"
          alt="<%= sanpham.tensp %>"
        />
      <% } %>
    </div>

    <!-- THÔNG TIN -->
    <div class="product-detail-info">
      <h2><%= sanpham.tensp %></h2>

      <p class="price">
        <%= sanpham.giatien.toLocaleString() %> VNĐ
      </p>

      <p class="stock">
        Còn lại: <strong><%= sanpham.soluongcon %></strong> sản phẩm
      </p>


      <p class="description">
        <%= sanpham.mota || "Chưa có mô tả cho sản phẩm này." %>
      </p>

      <!-- CHỌN SỐ LƯỢNG -->
      <div class="quantity-box">
        <button type="button" class="qty-btn" id="btn-decrease">−</button>

      <input
        type="number"
        id="quantity"
        value="1"
        min="1"
        max="<%= sanpham.soluongcon %>"
      />


        <button type="button" class="qty-btn" id="btn-increase">+</button>
      </div>

      <!-- NÚT THÊM GIỎ HÀNG -->
      <button
        class="btn add-to-cart"
        id="btn-add-cart"
        data-id="<%= sanpham.masp %>"
        data-name="<%= sanpham.tensp %>"
        data-price="<%= sanpham.giatien %>"
        data-image="<%= sanpham.hinhanh %>"
        data-stock="<%= sanpham.soluongcon %>"
      >
        🛒 Thêm vào giỏ hàng
      </button>
    </div>

  </div>
</div>

<%- include('../layouts/main-footer') %>
