<%- include('../layouts/main-header') %>

<div class="admin-container">

  <h2 class="admin-title">📦 Quản lý sản phẩm</h2>

  <!-- ========== FORM THÊM SẢN PHẨM ========== -->
  <div class="admin-card">
    <h3>➕ Thêm sản phẩm</h3>

    <form
      class="admin-form"
      action="/api/sanpham"
      method="POST"
      enctype="multipart/form-data"
    >

      <div class="form-grid">
        <input name="tensp" placeholder="Tên sản phẩm" required />
        <input name="giatien" type="number" placeholder="Giá (VNĐ)" required />
        <input name="soluongcon" type="number" placeholder="Số lượng" required />
        <input name="madm" type="number" placeholder="Mã danh mục" required />
        <input name="hinhanh" type="file" accept="image/*" />
        <!-- 👇 textarea chiếm 2 cột -->
        <textarea
          name="mota"
          rows="2"
          placeholder="Mô tả sản phẩm"
          class="textarea-2col"
        ></textarea>
      </div>

      <button class="btn btn-primary">Thêm sản phẩm</button>
    </form>
  </div>

  <!-- ========== DANH SÁCH SẢN PHẨM ========== -->
  <div class="admin-card">
    <h3>📋 Danh sách sản phẩm</h3>

    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Tên</th>
          <th>Giá</th>
          <th>Số lượng</th>
          <th>Ảnh</th>
          <th>Hành động</th>
        </tr>
      </thead>

      <tbody>
        <% sanphams.forEach(sp => { %>
          <tr>
            <td><%= sp.masp %></td>
            <td><%= sp.tensp %></td>
            <td class="price"><%= sp.giatien.toLocaleString() %> VNĐ</td>
            <td><%= sp.soluongcon %></td>
            <td>
              <% if (sp.hinhanh) { %>
                <img
                  src="/uploads/sanpham/<%= sp.hinhanh %>"
                  class="admin-img"
                />
              <% } %>
            </td>
            <td>
              <a href="/admin/sanpham/sua/<%= sp.masp %>" class="btn btn-edit">
                ✏️ Sửa
              </a>
              <a
                href="/admin/sanpham/xoa/<%= sp.masp %>"
                class="btn btn-delete"
                onclick="return confirm('Xóa sản phẩm này?')"
              >
                🗑 Xóa
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</div>

<%- include('../layouts/main-footer') %>
